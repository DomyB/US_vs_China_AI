_inner": null, "name": "Índice de Apertura en línea de Órganos Legislativos Subnacionales", "package_id": "9fef5aec-1e1f-45d1-adaf-79b20b50997d", "position": 3, "qa": {"resource_timestamp": null, "archival_timestamp": "2022-05-31T11:26:42.524811", "openness_score": 0, "openness_score_reason": "License not open", "format": "PDF", "created": "2018-02-28T17:26:34.367641", "updated": "2022-05-31T12:45:44.292619"}, "resource_type": null, "size": null, "spatial_coverage": "Uruguay", "spatial_ref_system": "", "state": "active", "temporal_coverage": "Mayo 2019", "update_frequency": "", "url": "https://catalogodatos.gub.uy/dataset/9fef5aec-1e1f-45d1-adaf-79b20b50997d/resource/3c53634e-a6d0-4b5c-b6b8-e79c98a32232/download/juntasuyestadodesituacionlibre.pdf", "url_type": "upload"}], "tags": [], "extras": [], "groups": [], "relationships_as_subject": [], "relationships_as_object": []}, {"author": "Cámara de Senadores", "author_email": "cdisalvatore@parlamento.gub.uy", "creator_user_id": "ecee534f-a475-4f7a-8bfd-86e422a8d0b1", "id": "250d98b6-5bb0-4c27-a41b-78dc55845bfe", "isopen": true, "license_id": "odc-uy", "license_title": "Licencia de DAG de Uruguay", "license_url": "https://www.gub.uy/agencia-gobierno-electronico-sociedad-informacion-conocimiento/sites/agencia-gobierno-electronico-sociedad-informacion-conocimiento/files/documentos/publicaciones/licencia_de_datos_abiertos_0.pdf", "maintainer": "Cámara de Senadores", "maintainer_email": "cdisalvatore@parlamento.gub.uy", "metadata_created": "2024-06-18T16:14:03.686806", "metadata_modified": "2024-06-26T17:27:23.259328", "name": "parlamento-del-uruguay-actividades-del-senado", "notes": "Este conjunto de datos contiene la información sobre todas las actividades del Plenario y de las Comisiones de la Cámara de Senadores del Parlamento del Uruguay.\r\n\r\nLos datos presentados son desde el año 1993 hasta la fecha, conteniendo fecha y hora, actividad ,sala y cuerpo legislativo ordenados por las distintas legislaturas.\r\n\r\nLa publicación de estos datos se enmarca en un compromiso de la Cámara de Senadores en el Quinto Plan de Acción de Gobierno Abierto, compromiso 4.2, fortalecer la política de acceso a la información pública y apertura de datos del Parlamento.", "num_resources": 11, "num_tags": 7, "organization": {"id": "2968e6a9-9274-4a76-941a-fdfdb7c1d180", "name": "parlamento-uruguayo", "title": "Parlamento del Uruguay", "type": "organization", "description": "Parlamento Uruguayo", "image_url": "2024-06-18-151826.897689logoredes.jpeg", "created": "2014-12-22T13:56:07.090753", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "2968e6a9-9274-4a76-941a-fdfdb7c1d180", "private": false, "state": "active", "title": "Actividades de la Cámara de Senadores", "type": "dataset", "update_frequency": "0", "url": "https://parlamento.gub.uy/camarasycomisiones/senadores/transparencia/datos-abiertos/", "version": "1.0", "groups": [{"description": "", "display_name": "Transparencia", "id": "8552e8e2-e342-43fe-ab27-4e3c50564f9b", "image_display_url": "https://catalogodatos.gub.uy/uploads/group/2019-08-22-234010.387437transparencia.png", "name": "transparencia", "title": "Transparencia"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2024-06-18T17:36:11.802659", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Datos descriptivos sobre las actividades Parlamentarias de la Cámara de Senadores en las distintas legislaturas.", "format": "CSV", "hash": "", "id": "2d72980b-9c8f-4a0b-9610-cba17d6d51a8", "last_modified": null, "metadata_modified": "2024-06-26T14:58:47.349761", "mimetype": "text/csv", "mimetype_inner": null, "name": "Metadatos de Actividades del Senado", "package_id": "250d98b6-5bb0-4c27-a41b-78dc55845bfe", "position": 0, "resource_type": null, "size": null, "spatial_coverage": "Uruguay", "spatial_ref_system": "", "state": "active", "temporal_coverage": "2000 - 2025", "update_freq